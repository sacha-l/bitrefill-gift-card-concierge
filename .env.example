# Copy this file to .env and paste your free Bitrefill developer API key.
# Get one (free, no card) at: https://www.bitrefill.com/account/developers
#
#   cp .env.example .env
#
# The key is read by .mcp.json via ${BITREFILL_API_KEY} env-var expansion,
# so it never gets committed.

BITREFILL_API_KEY=your_free_bitrefill_api_key_here
